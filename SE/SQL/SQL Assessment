Step 3: Create the place_order procedure

DELIMITER //

CREATE PROCEDURE place_order(
    IN p_customer_id INT,
    IN p_restaurant_id INT,
    IN p_amount INT
)
BEGIN
    START TRANSACTION;

    IF p_amount > (SELECT wallet_balance FROM customers WHERE customer_id = p_customer_id) THEN
        ROLLBACK;
    ELSE
        UPDATE customers
        SET wallet_balance = wallet_balance - p_amount
        WHERE customer_id = p_customer_id;

        INSERT INTO orders
            (customer_id, restaurant_id, total_amount, order_date)
        VALUES
            (p_customer_id, p_restaurant_id, p_amount, NOW());
        COMMIT;
    END IF;
END //

DELIMITER ;


