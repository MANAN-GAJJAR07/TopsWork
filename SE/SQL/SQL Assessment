-- SECTION D: AI-AUGMENTED MONTHLY RESTAURANT SUMMARY
-- Procedure accepts restaurant ID and month (1-12).
-- The corrected version filters to the current year and handles no orders.
-- =========================================================
DROP PROCEDURE IF EXISTS GetRestaurantMonthlySummary_AI;
DELIMITER $$
CREATE PROCEDURE GetRestaurantMonthlySummary_AI(
    IN p_restaurant_id INT,
    IN p_month INT
)
BEGIN
    DECLARE v_total_orders INT DEFAULT 0;
    DECLARE v_total_revenue DECIMAL(12,2) DEFAULT 0.00;
    DECLARE v_average_order_value DECIMAL(12,2) DEFAULT 0.00;

    IF p_month < 1 OR p_month > 12 OR p_month IS NULL THEN
        SELECT 'Invalid month: enter a number from 1 to 12.' AS message;
    ELSE
        SELECT COUNT(o.order_id),
               COALESCE(SUM(o.total_amount), 0.00),
               COALESCE(AVG(o.total_amount), 0.00)
        INTO v_total_orders, v_total_revenue, v_average_order_value
        FROM orders o
        WHERE o.restaurant_id = p_restaurant_id
          AND MONTH(o.order_date) = p_month
          AND YEAR(o.order_date) = YEAR(CURDATE())
        GROUP BY o.restaurant_id;

        IF v_total_orders = 0 THEN
            SELECT CONCAT(
                'No orders found for restaurant ', p_restaurant_id,
                ' in month ', p_month, ' of ', YEAR(CURDATE()), '.'
            ) AS message;
        ELSE
            SELECT p_restaurant_id AS restaurant_id,
                   p_month AS month_number,
                   YEAR(CURDATE()) AS report_year,
                   v_total_orders AS total_orders,
                   v_total_revenue AS total_revenue,
                   v_average_order_value AS average_order_value;
        END IF;
    END IF;
END$$
DELIMITER ;

