-- SECTION B - TASK 4: place_order PROCEDURE
-- MySQL transaction handling with rollback on errors/insufficient funds
-- =========================================================
DROP PROCEDURE IF EXISTS place_order;
DELIMITER $$
CREATE PROCEDURE place_order(
    IN p_customer_id INT,
    IN p_restaurant_id INT,
    IN p_amount DECIMAL(10,2)
)
BEGIN
    DECLARE v_balance DECIMAL(10,2);
    DECLARE v_customer_name VARCHAR(100);
    DECLARE v_customer_found INT DEFAULT 1;
    DECLARE v_restaurant_found INT DEFAULT 1;

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;

    START TRANSACTION;

    IF p_amount IS NULL OR p_amount <= 0 THEN
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Order amount must be greater than zero';
    END IF;

    SELECT COUNT(*) INTO v_customer_found
    FROM customers WHERE customer_id = p_customer_id;

    IF v_customer_found = 0 THEN
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Customer does not exist';
    END IF;

    SELECT COUNT(*) INTO v_restaurant_found
    FROM restaurants WHERE restaurant_id = p_restaurant_id;

    IF v_restaurant_found = 0 THEN
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Restaurant does not exist';
    END IF;

    -- Lock the customer row to prevent concurrent spending against the same balance.
    SELECT wallet_balance, customer_name
      INTO v_balance, v_customer_name
    FROM customers
    WHERE customer_id = p_customer_id
    FOR UPDATE;

    IF v_balance < p_amount THEN
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Insufficient wallet balance; order cancelled';
    END IF;

    UPDATE customers
    SET wallet_balance = wallet_balance - p_amount
    WHERE customer_id = p_customer_id;

    INSERT INTO orders (restaurant_id, customer_name, total_amount, order_date, customer_id)
    VALUES (p_restaurant_id, v_customer_name, p_amount, NOW(), p_customer_id);

    COMMIT;
    SELECT 'Order placed successfully' AS result,
           p_customer_id AS customer_id,
           p_amount AS amount_charged;
END$$
DELIMITER ;

