1.
Create two tables in SQL: influencers (with influencer_id as PRIMARY KEY and name) and posts (with post_id as PRIMARY KEY, influencer_id as FOREIGN KEY, and caption). Insert at least 3 influencers and 2 posts for each influencer.

CREATE TABLE influencers(influencer_id int PRIMARY KEY AUTO_INCREMENT,name varchar(100));

CREATE TABLE post(post_id int PRIMARY KEY AUTO_INCREMENT,influencer_id int,caption varchar(255),FOREIGN KEY(influencer_id) REFERENCES influencers(influencer_id));

